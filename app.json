{
  "expo": {
    "name": "pown",
    "slug": "pown",
    "version": "3.5.3",
    "runtimeVersion": "3.5.3",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-dark.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "icon": {
        "light": "./assets/images/app-icon-dark.png",
        "dark": "./assets/images/app-icon-dark.png"
      },
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.anonymous.workout-app",
      "appleTeamId": "W6FUWFHBPW",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["ko", "en"],
        "UIDesignRequiresCompatibility": true,
        "LSApplicationQueriesSchemes": ["googlegmail"],
        "NSHealthShareUsageDescription": "운동 중 에어팟 등 웨어러블에서 측정한 심박수와 칼로리를 실시간으로 보여주기 위해 건강 데이터를 읽습니다.",
        "NSHealthUpdateUsageDescription": "측정한 운동과 심박수·칼로리를 건강 앱에 저장해 활동 링에 반영합니다.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.anonymous.workoutapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "supportsTablet": true,
          "backgroundColor": "#ffffff",
          "image": "./assets/images/app-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/app-icon-dark.png",
            "backgroundColor": "#1a1a1a",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "운동 기록을 위해 사진을 촬영하거나 업로드하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": "운동 숏츠를 위해 마이크 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "운동 기록에 사용할 사진을 선택하거나 저장하려면 사진 라이브러리 접근 권한이 필요합니다.",
          "savePhotosPermission": "운동 기록에 사용할 사진을 선택하거나 저장하려면 사진 라이브러리 접근 권한이 필요합니다.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-localization",
      "./plugins/with-fmt-consteval-fix",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6495300075044721~8940153144",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "관련성 높은 광고를 보여주기 위해 사용됩니다. 허용하지 않아도 모든 기능을 그대로 쓸 수 있어요."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3cb3e29d-14bd-4783-849d-48be3148abd6"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/3cb3e29d-14bd-4783-849d-48be3148abd6"
    }
  }
}
